{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)",
    "schedule:monthly"
  ],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned container images used as workflow input defaults (e.g. semgrep-image)",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "default: '(?<depName>[a-z0-9./-]+):(?<currentValue>[^@']+)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
